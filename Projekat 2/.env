


BROKER_TYPE=mqtt


MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors
MQTT_QOS=1

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=iot-sensors
KAFKA_ACKS=1
KAFKA_CONSUMER_GROUP=iot-consumers
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1


POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iot_data
POSTGRES_USER=iotuser
POSTGRES_PASSWORD=iotpassword
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=iot_data;Username=iotuser;Password=iotpassword

DEVICE_COUNT=100
MESSAGES_PER_SECOND=10
SIMULATION_DURATION_SECONDS=60



STORAGE_ENABLED=true

BATCH_SIZE=500


TUMBLING_WINDOW_SECONDS=10
TEMPERATURE_ALERT_THRESHOLD=50.0


DATASET_PATH=/app/data/data_set.csv

SIMULATION_MODE=normal
BURST_RATE=5.0
BURST_DURATION=15