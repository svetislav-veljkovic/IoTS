BROKER_TYPE=mqtt

MQTT_HOST=iot-mosquitto
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors
MQTT_CEP_TOPIC=iot/analytics/events
MQTT_QOS=1

POSTGRES_HOST=iot-postgres
POSTGRES_PORT=5432
POSTGRES_DB=iot_data
POSTGRES_USER=iotuser
POSTGRES_PASSWORD=iotpassword
POSTGRES_CONNECTION_STRING=Host=iot-postgres;Port=5432;Database=iot_data;Username=iotuser;Password=iotpassword

DEVICE_COUNT=100
MESSAGES_PER_SECOND=10
SIMULATION_DURATION_SECONDS=60
SIMULATION_MODE=normal
BURST_RATE=5.0
BURST_DURATION=15
CRITICAL_RATIO=0.05
DATASET_PATH=/app/data/data_set.csv

STORAGE_ENABLED=true
BATCH_SIZE=500

TUMBLING_WINDOW_SECONDS=10
TEMPERATURE_ALERT_THRESHOLD=50.0
MAAS_URL=http://maas:8000
